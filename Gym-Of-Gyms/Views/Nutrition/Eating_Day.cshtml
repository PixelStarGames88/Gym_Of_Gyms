@{
    ViewData["Title"] = "Дневник питания";
}

<div class="page-split">
    <div class="bg-panel panel-diary-food-left"></div>

    <div class="container-main center-wide">
        <h1 style="text-align: center;">Дневник питания.</h1>
        <div class="exercise-container">
            <div class="date-navigator">
                <button type="button" class="btn-custom">Вчера</button>
                <h2 id="currentDate"></h2>
                <button type="button" class="btn-custom">Завтра</button>
            </div>
        </div>
        <form asp-controller="Nutrition" asp-action="Eating" asp-route-username="@ViewContext.RouteData.Values["username"]" method="get">
            <button type="submit" class="btn-custom-center" onclick="addExercise()">Добавить прием пищи</button>
        </form>
    </div>

   

    <div class="bg-panel panel-diary-food-right"></div>
</div>

<script src="~/js/food-diary.js"></script>