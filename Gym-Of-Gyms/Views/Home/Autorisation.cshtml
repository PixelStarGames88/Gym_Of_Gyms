@{
    ViewData["Title"] = "Авторизация";
}

<div class="page-split">
    <div class="container-main left-side">
        <h1>Gym of Gyms</h1>
        <h2>Добро пожаловать!</h2>

        <form asp-controller="UserGym" asp-action="EnterToAccount" method="post">
            <div class="form-group">
                <label for="login">Введи логин</label>
                <input type="text" id="login" class="styled-input" name="login" />
            </div>

            <div class="form-group">
                <label for="password">Введи пароль</label>
                <input type="password" id="password" class="styled-input" name="password" />
            </div>

            <button type="submit" class="btn-custom" onclick="toggleMessage()">
                Авторизироваться
            </button>
        </form>

        <p>
            <a asp-controller="Home" asp-action="Registration">
                В первый раз? Зарегестрируйся.
            </a>
        </p>
    </div>

    <div class="bg-panel panel-autorisation"></div>
</div>