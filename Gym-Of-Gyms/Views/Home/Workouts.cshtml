@{
    ViewData["Title"] = "Дневник тренировок";
}

<div class="page-split">
    <div class="bg-panel panel-diary-work-left"></div>

    <div class="container-main center-wide">
        <h1 style="text-align: center;">Дневник тренировок.</h1>
        <div class="exercise-container">
            <div class="date-navigator">
                <button type="button" class="btn-custom">Вчера</button>
                <h2 id="currentDate"></h2>
                <button type="button" class="btn-custom">Завтра</button>
            </div>
        </div>
        <button type="button" class="btn-custom" onclick="addExercise()">Добавить упражнение</button>
    </div>

    <div class="bg-panel panel-diary-work-right"></div>
</div>

<script src="~/js/workout-diary.js"></script>