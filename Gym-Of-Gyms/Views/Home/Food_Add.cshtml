@{
    ViewData["Title"] = "Добавление еды";
    var currentUsername = ViewContext.RouteData.Values["username"]?.ToString();
}

<div class="page-split">
    <div class="bg-panel panel-food-registration"></div>

    <div class="container-main right-side">
        <h1>Gym of Gyms</h1>
        <h3>Добавь новый продукт!</h3>

        <form asp-controller="Food" asp-action="CreateFood" asp-route-username="@ViewContext.RouteData.Values["username"]" method="post">
            <table class="form-table">
                <tr>
                    <td><label for="foodName">Введи название</label></td>
                </tr>
                <tr>
                    <td><input type="text" id="foodName" class="styled-input" name="foodName" /></td>
                </tr>
                <tr>
                    <td><label for="calories">Введи калории (ккал.)</label></td>
                    <td><label for="mass">Введи массу на которую прихоятся эти калории (г.)</label></td>
                </tr>
                <tr>
                    <td><input type="text" class="styled-input inp-weight" placeholder="0.00" id="calories" name="calories" /></td>
                    <td><input type="text" class="styled-input inp-weight" placeholder="0.00" id="mass" name="mass" /></td>
                </tr>
                <tr>
                    <td><label for="protein">Введи количество белков (г.)</label></td>
                    <td><label for="fat">Введи количество жиров (г.)</label></td>
                    <td><label for="carbohydrates">Введи количество углеводов (г.)</label></td>
                </tr>
                <tr>
                    <td><input type="text" class="styled-input inp-weight" placeholder="0.00" id="protein" name="protein" /></td>
                    <td><input type="text" class="styled-input inp-weight" id="fat" name="fat" placeholder="0.00" /></td>
                    <td><input type="text" class="styled-input inp-weight" placeholder="0.00" id="carbohydrates" name="carbohydrates" /></td>
                </tr>
            </table>

            <button type="submit" class="btn-custom">
                Добавить продукт
            </button>
        </form>

        <p>
            <a asp-controller="Home" asp-action="Food_List" asp-route-username="@currentUsername">
                Кажется.. Я передумал добавлять новый продукт...
            </a>
        </p>
    </div>
</div>